{
  "name": "@open-cr-agent/core",
  "version": "0.3.0",
  "description": "Domain types, review pipeline stages and plugin contracts for Open-CR-Agent",
  "keywords": [
    "code-review",
    "llm",
    "agents",
    "pipeline"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ocracloud.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jma49/Open-CR-Agent.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/jma49/Open-CR-Agent/issues",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@open-cr-agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "@open-cr-agent/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "picomatch": "^4.0.7",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
