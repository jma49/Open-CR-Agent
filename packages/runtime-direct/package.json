{
  "name": "@open-cr-agent/runtime-direct",
  "version": "0.2.0",
  "description": "Agent runtime for Open-CR-Agent that calls OpenAI-compatible endpoints directly",
  "keywords": [
    "code-review",
    "openai-compatible",
    "agents"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ocra.majincheng.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jma49/Open-CR-Agent.git",
    "directory": "packages/runtime-direct"
  },
  "bugs": "https://github.com/jma49/Open-CR-Agent/issues",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@open-cr-agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@open-cr-agent/core": "0.2.0",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
