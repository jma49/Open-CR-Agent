      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@open-cr-agent/core": "0.1.0",
    "zod": "^4.6.5"
