{
  "name": "@open-cr-agent/vcs-local",
  "version": "0.1.0",
  "description": "Local git adapter for Open-CR-Agent: working tree, ranges and commits",
  "keywords": [
    "code-review",
    "git"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ocra.majincheng.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jma49/Open-CR-Agent.git",
    "directory": "packages/vcs-local"
  },
  "bugs": "https://github.com/jma49/Open-CR-Agent/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
