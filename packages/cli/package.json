{
  "name": "@open-cr-agent/cli",
  "version": "0.6.0",
  "description": "ocra: open-source AI code review built for pull requests you do not trust, for local changes, GitHub and GitLab",
  "keywords": [
    "code-review",
    "cli",
    "llm",
    "agents",
    "github-action"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ocracloud.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jma49/Open-CR-Agent.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/jma49/Open-CR-Agent/issues",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "exports": {
    ".": {
      "@open-cr-agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "@open-cr-agent/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ocra": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@open-cr-agent/cloud-contract": "0.6.0",
    "@open-cr-agent/core": "0.6.0",
    "@open-cr-agent/runtime-direct": "0.6.0",
    "@open-cr-agent/vcs-github": "0.6.0",
    "@open-cr-agent/vcs-gitlab": "0.6.0",
    "@open-cr-agent/vcs-local": "0.6.0",
    "@open-cr-agent/vcs-platform": "0.6.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@open-cr-agent/runtime-opencode": "0.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@open-cr-agent/test-support": "0.0.0"
  }
}
