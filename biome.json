{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.tsbuildinfo",
      "!evals/golden/*.json",
      "!docs/schema/*.json",
      "!docs/images/*.svg",
      "!**/__snapshots__",
      "!packages/runtime-direct/src/recordings"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": ["./biome-plugins/error-casts.grit"],
  "overrides": [
    {
      "includes": ["vitest.config.ts", "commitlint.config.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
