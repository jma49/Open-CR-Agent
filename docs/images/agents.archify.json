  "cards": [
    {
      "dot": "cyan",
      "title": "Reviewer agents",
      "items": [
        "One task per bundle \u00d7 reviewer cell, run in parallel (4 at a time by default)",
        "Tools: read_file, read_diff, code_search, report_finding, task_done",
        "No shell, no web; findings only through report_finding",
        "Large bundles, or every task under --ultra, get a plan-phase checklist first; --ultra also samples each cell twice"
      ]
    },
    {
      "dot": "violet",
      "title": "Model tiers",
      "items": [
        "top: Judge",
        "standard: correctness, security, performance, Verifier",
        "light: Bundler, docs, agents-md, relocation",
        "Each tier is a chain of models with failback and circuit breakers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code decides",
      "items": [
        "Which reviewer runs on which bundle",
        "Where a finding lands (quoted code, never model line numbers)",
        "The verdict, from the judged findings"
      ]
    }
