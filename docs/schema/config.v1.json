{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocra.majincheng.com/schema/config.v1.json",
  "title": "ocra configuration",
  "description": "The .ocra/config.json file of a repository, or a file passed with --config. Unknown keys are rejected.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "properties": {
        "top": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "standard": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "light": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "effort": {
      "default": {},
      "type": "object",
      "properties": {
        "top": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "standard": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "light": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "taskTimeoutMinutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 35791
    },
    "runTimeoutMinutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 35791
    },
    "verify": {
      "type": "boolean"
    },
    "judge": {
      "type": "boolean"
    },
    "showPreExisting": {
      "type": "boolean"
    },
    "ultra": {
      "type": "boolean"
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "minInlineSeverity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "suggestion"
      ]
    },
    "maxInlineComments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "walkthrough": {
      "type": "boolean"
    },
    "fixes": {
      "type": "boolean"
    },
    "linkedTasks": {
      "type": "boolean"
    },
    "guidelineScope": {
      "type": "string",
      "enum": [
        "all",
        "matched",
        "reviewer"
      ]
    },
    "trackers": {
      "default": {},
      "type": "object",
      "properties": {
        "jira": {
          "type": "object",
          "properties": {
            "projects": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,9}$"
              }
            },
            "server": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "tokenEnv": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "keyArgument": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "projects",
            "server",
            "tool",
            "keyArgument"
          ],
          "additionalProperties": false
        },
        "tapd": {
          "type": "object",
          "properties": {
            "workspace": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "server": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "tokenEnv": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            "tools": {
              "type": "object",
              "properties": {
                "story": {
                  "type": "string",
                  "minLength": 1
                },
                "bug": {
                  "type": "string",
                  "minLength": 1
                },
                "task": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "keyArgument": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "workspace",
            "server",
            "tools",
            "keyArgument"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projectDocs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "mergeChecks": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.:-]{1,64}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "instruction"
        ],
        "additionalProperties": false
      }
    },
    "maxCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxTasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sampling": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "github": {
      "default": {},
      "type": "object",
      "properties": {
        "requestChanges": {
          "type": "boolean"
        },
        "botLogin": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cloud": {
      "default": {},
      "type": "object",
      "properties": {
        "shareRepoName": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "learnings": {
      "default": {},
      "type": "object",
      "properties": {
        "requireReview": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "include": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "opencode",
            "direct"
          ]
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "plugins": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "minTier": {
            "type": "string",
            "enum": [
              "trivial",
              "lite",
              "full"
            ]
          },
          "models": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "verifier",
          "judge",
          "helper",
          "writer",
          "fixer"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "models": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "pluginSettings": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "providers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "openai-compatible",
              "anthropic"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "apiKeyEnv": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[\\w./:@-]{1,200}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "output": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "cachedInput": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 8000,
                  "maximum": 10000000
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "effort": {
            "type": "string",
            "enum": [
              "openai",
              "openrouter"
            ]
          },
          "toolCalls": {
            "type": "string",
            "enum": [
              "api",
              "text"
            ]
          }
        },
        "required": [
          "type",
          "baseUrl",
          "models"
        ],
        "additionalProperties": false
      }
    },
    "extends": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
