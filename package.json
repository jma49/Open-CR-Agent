{
  "name": "open-cr-agent",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/mark-bins.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "verify": "npm run check && npm run typecheck && npm run check:api && npm run knip && npm test",
    "clean": "node scripts/clean.mjs",
    "check:packages": "npm run clean && npm run build && node scripts/check-packages.mjs",
    "schema": "npm run build && node scripts/schema.mjs",
    "test:coverage": "vitest run --coverage",
    "api": "npm run build && node scripts/api-report.mjs",
    "check:api": "node scripts/api-report.mjs --check",
    "knip": "knip --no-progress",
    "version-packages": "node scripts/changelog.mjs version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@microsoft/api-extractor": "^7.59.3",
    "@open-cr-agent/cli": "*",
    "@open-cr-agent/core": "*",
    "@types/node": "~26.6.3",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "knip": "^6.39.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@10.9.9"
}
