{
  "name": "open-cr-agent",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/mark-bins.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "verify": "npm run check && npm run typecheck && npm run check:api && npm test",
    "clean": "node -e \"for (const p of require('fs').readdirSync('packages')) require('fs').rmSync('packages/' + p + '/dist', { recursive: true, force: true })\" && find packages -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "check:packages": "npm run clean && npm run build && node scripts/check-packages.mjs",
    "schema": "npm run build && node scripts/schema.mjs",
    "test:coverage": "vitest run --coverage",
    "api": "npm run build && node scripts/api-report.mjs",
    "check:api": "node scripts/api-report.mjs --check",
    "version-packages": "node scripts/changelog.mjs version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@microsoft/api-extractor": "^7.59.3",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@10.9.9"
}
