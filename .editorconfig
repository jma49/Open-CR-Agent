# Editors' defaults, matching Biome's formatter (biome.json).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown line breaks; diff fixtures and snapshots keep their bytes.
[{*.md,*.mdx,*.diff,*.snap}]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
